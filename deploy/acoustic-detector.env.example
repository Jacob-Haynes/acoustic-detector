# /etc/acoustic-detector.env (root-only, never commit the real one)

# --- Sensor identity and position (needed for ATAK markers) ---
SENSOR_NAME=OP1
#SENSOR_LAT=51.15000
#SENSOR_LON=-1.75000
#SENSOR_HAE=0
# Radius drawn on the ATAK marker. Acoustics gives presence, not position.
DETECT_RADIUS_M=300
# u = unknown, h = hostile
COT_AFFILIATION=u
COT_SENSOR_MARKER=1

# --- Input: auto | mic | simulate | /path/to/clip.wav ---
ACOUSTIC_INPUT=auto
# Device index or name from: /opt/acoustic-detector/.venv/bin/python -m acoustic --list-devices
#AUDIO_DEVICE=
#ACOUSTIC_ARGS=

# --- Detection tuning ---
DETECT_ON=0.65
DETECT_OFF=0.40
ALERT_COOLDOWN=60
#USE_YAMNET=1

# --- ATAK (OpenTAKServer plain CoT TCP) ---
TAK_HOST=127.0.0.1
TAK_PORT=8087

# --- Mesh alerts via the blufor-tracker bridge (meshbus/tx on RabbitMQ MQTT) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
# Unset = broadcast. Or a node id like !a1b2c3d4
#MESH_TO=
MESH_CHANNEL=0
MESH_CLEAR_MSG=0

# --- Optional cloud second opinion. Uploads audio clips to Google: demo audio only. ---
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
GEMINI_AUTO=1
