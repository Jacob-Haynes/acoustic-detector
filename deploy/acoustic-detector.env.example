# /etc/acoustic-detector.env (root-only, never commit the real one)

# --- Sensor identity and position (needed for ATAK markers) ---
SENSOR_NAME=OP1
#SENSOR_LAT=51.15000
#SENSOR_LON=-1.75000
#SENSOR_HAE=0
# Radius drawn on the ATAK marker. Acoustics gives presence, not position.
DETECT_RADIUS_M=300
# u = unknown, h = hostile
COT_AFFILIATION=u
COT_SENSOR_MARKER=1

# --- Input: auto | mic | simulate | /path/to/clip.(wav|mp3|flac|mp4|mov) ---
ACOUSTIC_INPUT=auto
# Device index or name (substring match) from:
#   sudo -u acoustic /opt/acoustic-detector/.venv/bin/python -m acoustic --list-devices
# Unset = first USB capture device. A device picked in the web UI is saved and wins over this.
#AUDIO_DEVICE=USB
#ACOUSTIC_ARGS=

# --- Detection tuning ---
DETECT_ON=0.65            # raise (e.g. 0.75) if a noisy room false-triggers
DETECT_OFF=0.40
DETECT_ON_FRAMES=3        # consecutive 0.5 s windows above DETECT_ON before alerting
DETECT_OFF_FRAMES=6       # consecutive windows below DETECT_OFF before clearing
ALERT_COOLDOWN=60         # seconds before a new detection sends another mesh alert
#USE_YAMNET=1

# --- ATAK (OpenTAKServer plain CoT TCP) ---
TAK_HOST=127.0.0.1
TAK_PORT=8087

# --- MQTT on the Pi hub: mesh alerts (meshbus/tx) + heartbeat (isrkit/heartbeat/acoustic-detector) ---
# On the Pi: 127.0.0.1 with guest/guest. From a laptop: isr-pi.local with user isrkit
# (RabbitMQ's guest account is loopback-only).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
# URL advertised to the launcher (default http://<hostname>.local:8100)
#PUBLIC_URL=http://isr-pi.local:8100
# Unset = broadcast. Or a node id like !a1b2c3d4
#MESH_TO=
MESH_CHANNEL=0
MESH_CLEAR_MSG=0

# --- Optional cloud second opinion. Uploads audio clips to Google: demo audio only. ---
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
GEMINI_AUTO=1
